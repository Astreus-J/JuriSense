# Variáveis de ambiente locais (use .env.example como modelo)
.env
# Production compose-level secrets (.env.production.example is the tracked template;
# backend/.env, which holds the app-level production secrets, is already covered by the
# plain ".env" pattern above since it matches at any depth).
.env.production

# Python
__pycache__/
*.pyc

# Claude Code local state (ephemeral) -- .claude/agents/ (project subagent
# definitions) and .claude/skills/ are intentionally NOT ignored; they're
# committed project configuration, not local state.
.claude/worktrees/
.claude/settings.local.json

# Sandbox-only DNS override for docker compose (this specific dev environment's Docker
# embedded DNS resolver can't reach external APIs without it) -- committing it would
# silently change every developer's `docker compose` behavior.
docker-compose.override.yml

# demo-video pipeline: regenerable/raw artifacts, not meant to be committed -- see
# docs/08-hackathon/demo-video/README.md for how to reproduce them.
docs/08-hackathon/demo-video/node_modules/
docs/08-hackathon/demo-video/video/
docs/08-hackathon/demo-video/run-info.json
docs/08-hackathon/demo-video/timeline.json
docs/08-hackathon/demo-video/presentation-narration.wav

# pitch pipeline: same regenerable-artifact rule as demo-video above.
docs/08-hackathon/Pitch/pitch-narration.wav
docs/08-hackathon/Pitch/slides_hires/
