# Variáveis do docker-compose de desenvolvimento.
# Copie para .env na raiz para sobrescrever os defaults — nada aqui é obrigatório.
# O Postgres e o MinIO agora são self-hosted pelo próprio compose (ADR-001 addendum e
# ADR-008 addendum, 2026-10-15 — não usamos mais Neon nem Cloudflare R2). Os demais
# segredos do backend (JWT_SECRET_KEY, SMTP, AI Gateway, etc.) continuam em
# backend/.env, carregado pelo compose via env_file. Veja backend/.env.example.

# Ambiente: development | staging | production
ENVIRONMENT=development
DEBUG=true

# Origens permitidas no CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# URL da API vista pelo navegador (frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Credenciais do Postgres self-hosted (serviço `postgres` do compose)
POSTGRES_USER=jurisense
POSTGRES_PASSWORD=jurisense
POSTGRES_DB=jurisense

# Credenciais do MinIO self-hosted (serviços `minio`/`minio-init` do compose, também
# o root user/password do MinIO) -- DEV ONLY, nunca usar em produção.
DEV_STORAGE_ACCESS_KEY=jurisense
DEV_STORAGE_SECRET_KEY=jurisense-dev-secret
STORAGE_BUCKET=jurisense-dev
