# Variáveis do docker-compose de desenvolvimento.
# Copie para .env na raiz para sobrescrever os defaults — nada aqui é obrigatório.
# O banco é o PostgreSQL gerenciado externo: DATABASE_URL (e demais segredos do
# backend, como JWT_SECRET_KEY e SMTP) ficam em backend/.env, carregado pelo
# compose via env_file. Veja backend/.env.example.

# Ambiente: development | staging | production
ENVIRONMENT=development
DEBUG=true

# Origens permitidas no CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# URL da API vista pelo navegador (frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
