# Variáveis do docker-compose de desenvolvimento.
# Copie para .env na raiz para sobrescrever os defaults — nada aqui é obrigatório.
# (O .env do backend/ é usado apenas ao rodar a API fora do Docker.)

# Ambiente: development | staging | production
ENVIRONMENT=development
DEBUG=true

# Credenciais do Postgres local (compõem também a DATABASE_URL do backend)
POSTGRES_USER=jurisense
POSTGRES_PASSWORD=jurisense
POSTGRES_DB=jurisense

# Pool de conexões do SQLAlchemy
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Origens permitidas no CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# URL da API vista pelo navegador (frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
