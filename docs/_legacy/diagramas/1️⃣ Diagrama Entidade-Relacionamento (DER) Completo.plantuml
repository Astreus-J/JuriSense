    %% ========== ENTIDADES PRINCIPAIS ==========
    
    USUARIO {
        int id PK
        string nome
        string email UK
        string senha_hash
        string telefone
        boolean ativo
        boolean autenticacao_2fa
        datetime ultimo_acesso
        int escritorio_id FK
        int perfil_id FK
        datetime criado_em
        datetime atualizado_em
    }
    
    PERFIL {
        int id PK
        string nome
        string descricao
        boolean ativo
    }
    
    PERMISSAO {
        int id PK
        int perfil_id FK
        string modulo
        string acao
        boolean permitido
    }
    
    ESCRITORIO {
        int id PK
        string razao_social
        string cnpj UK
        string endereco
        string telefone
        string logo_url
        boolean ativo
        datetime criado_em
    }
    
    PROCESSO {
        int id PK
        string numero_processo UK
        string numero_cnj
        int tribunal_id FK
        int responsavel_id FK
        int cliente_id FK
        string status
        string tipo_acao
        string comarca
        string vara
        decimal valor_causa
        date data_distribuicao
        date data_ultima_movimentacao
        text observacoes
        boolean sincronizacao_ativa
        datetime proximo_sincronizacao
        datetime criado_em
        datetime atualizado_em
    }
    
    TRIBUNAL {
        int id PK
        string nome
        string sigla UK
        string tipo
        string url_consulta
        boolean suporta_api
        string endpoint_api
        boolean ativo
    }
    
    PARTE {
        int id PK
        int processo_id FK
        int cliente_id FK
        int tipo_parte_id FK
        string nome
        string cpf_cnpj
        string qualificacao
        boolean polo_ativo
    }
    
    CLIENTE {
        int id PK
        string nome
        string cpf_cnpj UK
        string email
        string telefone
        string endereco
        int responsavel_id FK
        boolean ativo
        datetime criado_em
    }
    
    DOCUMENTO {
        int id PK
        int processo_id FK
        int tipo_documento_id FK
        int usuario_id FK
        string titulo
        string nome_arquivo
        string caminho_arquivo
        string hash_arquivo
        int tamanho_bytes
        string mime_type
        boolean assinado_digitalmente
        boolean ocr_processado
        text conteudo_extraido
        datetime data_upload
        datetime criado_em
    }
    
    VERSAO_DOCUMENTO {
        int id PK
        int documento_id FK
        int versao
        int usuario_id FK
        string caminho_arquivo
        text motivo_alteracao
        datetime criado_em
    }
    
    TIPO_DOCUMENTO {
        int id PK
        string nome
        string categoria
        boolean requer_assinatura
        boolean ativo
    }
    
    MOVIMENTACAO {
        int id PK
        int processo_id FK
        date data_movimentacao
        string tipo
        text descricao
        string origem
        boolean gera_prazo
        datetime sincronizado_em
        datetime criado_em
    }
    
    PRAZO {
        int id PK
        int processo_id FK
        int responsavel_id FK
        int movimentacao_id FK
        string descricao
        date data_prazo
        date data_prazo_fatal
        int dias_antecedencia
        string status
        string prioridade
        datetime cumprido_em
        datetime criado_em
    }
    
    NOTIFICACAO {
        int id PK
        int usuario_id FK
        int prazo_id FK
        int template_id FK
        string tipo
        string titulo
        text mensagem
        boolean lida
        datetime enviado_em
        datetime lida_em
        string canal
    }
    
    TEMPLATE_NOTIFICACAO {
        int id PK
        string nome
        string tipo
        text template_html
        text template_texto
        boolean ativo
    }
    
    PETICAO_IA {
        int id PK
        int processo_id FK
        int usuario_id FK
        int template_id FK
