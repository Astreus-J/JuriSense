        text prompt_usuario
        text conteudo_gerado
        float confianca_score
        string status
        datetime gerado_em
        datetime aprovado_em
    }
    
    TEMPLATE_PETICAO {
        int id PK
        string nome
        string tipo_peticao
        text estrutura_json
        text prompt_base
        boolean ativo
    }
    
    MODELO_IA {
        int id PK
        string nome
        string versao
        string provider
        string endpoint
        json parametros
        boolean ativo
    }
    
    JURIMETRIA {
