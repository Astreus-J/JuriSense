# Compose-level variables for docker-compose.prod.yml. Copy to .env.production, fill in
# real values, and run:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# App-level secrets (JWT, SMTP, AI Gateway, anchoring) live in backend/.env instead --
# see backend/.env.production.example. Nothing in this file has a safe default on
# purpose: docker-compose.prod.yml does not fall back to dev credentials like
# docker-compose.yml does.

# Public URL your browser hits for the API -- goes through nginx, so this is the public
# domain (or the VPS's IP for a first smoke test before DNS is set up), not "backend".
NEXT_PUBLIC_API_URL=https://your-domain.example/api

# Allowed CORS origins (JSON array) -- must match the public frontend origin(s) exactly.
CORS_ORIGINS=["https://your-domain.example"]

# Postgres credentials (self-hosted `postgres` service) -- generate a real password with
# e.g. `openssl rand -hex 24`, never reuse the dev defaults.
POSTGRES_USER=jurisense
POSTGRES_PASSWORD=
POSTGRES_DB=jurisense

# MinIO credentials (self-hosted `minio`/`minio-init` services; also MinIO's root
# user/password) -- generate real values, never reuse the dev defaults
# (jurisense/jurisense-dev-secret from .env.example are DEV ONLY).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=jurisense-prod
