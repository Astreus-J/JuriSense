# Production app secrets for backend/.env (loaded by docker-compose.prod.yml's
# backend/celery-worker/celery-beat services via env_file). Copy to backend/.env on the
# VPS and fill in every value below -- app/core/config.py::_require_production_secrets
# refuses to boot with ENVIRONMENT=production if any of the marked ones are missing or
# still a dev-default value, so a misconfigured deploy fails loudly at startup instead
# of silently in the first request that needs the missing secret.
#
# DATABASE_URL, REDIS_URL and STORAGE_* are intentionally NOT set here: docker-
# compose.prod.yml overrides them to point at the postgres/redis/minio services using
# the credentials from .env.production (repo root) -- see .env.production.example.
# Setting them here too would just be dead config that the compose override always wins
# over.

ENVIRONMENT=production
DEBUG=false

# REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# REQUIRED. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=

# REQUIRED (app/core/config.py raises at startup without it). Without SMTP configured,
# password-reset and invite links would otherwise be written to the application log
# instead of emailed -- a real security issue, which is why the app refuses to boot
# without this in production rather than silently degrading.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="JuriSense <no-reply@your-domain.example>"

# Public frontend URL, used in email links (password reset, invites).
FRONTEND_URL=https://your-domain.example

# REQUIRED. The AI Gateway's current startup check (app/core/config.py,
# _require_production_secrets) unconditionally requires this even if
# AI_GATEWAY_PROVIDER=gemini below -- a known gap, not a typo; set a real OpenRouter key
# regardless of which provider you intend to use day to day.
OPENROUTER_API_KEY=

# Optional: switch the AI Gateway to Gemini (ADR-005's multi-provider abstraction).
# "openrouter" (default) needs no extra variables beyond OPENROUTER_API_KEY above.
#AI_GATEWAY_PROVIDER=gemini
#GEMINI_API_KEY=

# Blockchain anchoring (ADR-007). "transparency_log" (the default) needs no external
# credentials. Flip to "constellation_digital_evidence" only once every
# CONSTELLATION_DED_* value below is set -- app/core/config.py checks this combination
# regardless of ENVIRONMENT and fails startup if the provider is set but the credentials
# aren't.
ANCHORING_PROVIDER=transparency_log
#CONSTELLATION_DED_API_KEY=
#CONSTELLATION_DED_ORG_ID=
#CONSTELLATION_DED_TENANT_ID=
# Generated locally, never requested from Constellation -- generate with: openssl rand -hex 32
#CONSTELLATION_DED_PRIVATE_KEY=
