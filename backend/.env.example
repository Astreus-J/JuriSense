# Ambiente: development | staging | production
ENVIRONMENT=development
DEBUG=false

# PostgreSQL gerenciado externo
DATABASE_URL=postgresql+asyncpg://jurisense:jurisense@localhost:5432/jurisense
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Autenticação (JWT) — obrigatório em produção; gere com: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-insecure-secret-with-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bloqueio de login após tentativas falhas
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# E-mail (SMTP) — sem SMTP_HOST, e-mails vão para o log (dev)
#SMTP_HOST=
SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
EMAIL_FROM="JuriSense <no-reply@jurisense.local>"

# URL base do frontend usada nos links de e-mails
FRONTEND_URL=http://localhost:3000

# Recuperação de senha e convites
PASSWORD_RESET_EXPIRE_MINUTES=60
INVITE_EXPIRE_DAYS=7

# Redis na VPS (cache e filas)
REDIS_URL=redis://localhost:6379/0

# Diretório raiz dos documentos por empresa (filesystem da VPS)
DOCUMENTS_ROOT=/dados/empresas

# Origens permitidas no CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]
