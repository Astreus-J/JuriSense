# Environment: development | staging | production
ENVIRONMENT=development
DEBUG=false

# External managed PostgreSQL
DATABASE_URL=postgresql+asyncpg://jurisense:jurisense@localhost:5432/jurisense
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Authentication (JWT) -- required in production; generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-insecure-secret-with-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login lockout after failed attempts
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Integration connector credentials at rest -- required in production; generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=K8ICvuSzZmFZO1MpA4lBQhyPp8s079pIIZH41eUoU2s=

# Email (SMTP) -- with no SMTP_HOST, emails go to the log (dev)
#SMTP_HOST=
SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
EMAIL_FROM="JuriSense <no-reply@jurisense.local>"

# Frontend base URL, used in email links
FRONTEND_URL=http://localhost:3000

# Password reset and invitations
PASSWORD_RESET_EXPIRE_MINUTES=60
INVITE_EXPIRE_DAYS=7

# Redis on the VPS (cache and queues)
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible): s3mock in dev, Cloudflare R2 in production
# (ADR-008 addendum -- MinIO, the original dev choice, no longer publishes a
# freely pullable image). The values below match docker-compose.yml's
# `s3mock` service -- DEV ONLY, never use these credentials in production.
STORAGE_ENDPOINT_URL=http://localhost:9090
STORAGE_ACCESS_KEY=test
STORAGE_SECRET_KEY=test
STORAGE_BUCKET=jurisense-dev
STORAGE_REGION=us-east-1

# Allowed CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Blockchain anchoring (ADR-007). "transparency_log" needs no external credentials and is
# the honest default until Constellation DED credentials are provisioned (Plane #198 --
# not self-service, requested directly from Constellation). Flip to
# "constellation_digital_evidence" only once every CONSTELLATION_DED_* value below is set.
ANCHORING_PROVIDER=transparency_log
#CONSTELLATION_DED_API_KEY=
#CONSTELLATION_DED_ORG_ID=
#CONSTELLATION_DED_TENANT_ID=
# Generated locally, never requested from Constellation -- generate with: openssl rand -hex 32
#CONSTELLATION_DED_PRIVATE_KEY=
